<Window x:Class="UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:h="clr-namespace:HelixToolkit.Wpf;assembly=HelixToolkit.Wpf"
        Title="Algorithm Lab · Анализ сложности"
        Width="1440" Height="900" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#0B1020" Foreground="#E8ECF5"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#11182A" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#202B42" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8995AD" />
        <!-- Цвет обычного текста наследуется от Window.Foreground; неявный стиль TextBlock здесь
             не нужен: он перекрашивал и текст пунктов выпадающих списков (белый на белом). -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8995AD" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#E8ECF5" />
            <Setter Property="Background" Value="#0C1323" />
            <Setter Property="BorderBrush" Value="#293650" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CaretBrush" Value="#69D8C2" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#69D8C2" />
                    <Setter Property="Background" Value="#0F1930" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Пункты выпадающих списков лежат на белом popup — текст чёрный -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <!-- Штатный шаблон ComboBox игнорирует Background/Foreground, поэтому свой:
             тёмное поле в закрытом и выключенном состоянии, белый popup с чёрными пунктами -->
        <Style x:Key="FieldCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E8ECF5" />
            <Setter Property="Background" Value="#0C1323" />
            <Setter Property="BorderBrush" Value="#293650" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,9,34,9" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <ContentPresenter
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    TextElement.Foreground="{TemplateBinding Foreground}"
                                    IsHitTestVisible="False" />
                            </Border>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent" BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Path x:Name="Arrow" Data="M 0 0 L 4.5 4.5 L 9 0 Z" Fill="#8995AD"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Arrow" Property="Fill" Value="#69D8C2" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Placement="Bottom" Focusable="False" PopupAnimation="Fade">
                                <Border Background="White" BorderBrush="#C9D0DC" BorderThickness="1" CornerRadius="6"
                                        Margin="0,5,0,0" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer Margin="5" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#69D8C2" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#69D8C2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                                <Setter Property="Foreground" Value="#65718A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Штатный шаблон Button в выключенном состоянии заливает кнопку светло-серым,
             поверх которого теряется светлый текст — поэтому тоже свой шаблон -->
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E8ECF5" />
            <Setter Property="Background" Value="#202B42" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="#11182A" />
            <Setter Property="BorderBrush" Value="#202B42" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18,15" />
        </Style>
        <!-- Тонкий тёмный скроллбар для левой панели (заменяет светлый системный) -->
        <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBg" Background="#2E3B57" CornerRadius="3" Margin="1,0" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBg" Property="Background" Value="#465878" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBg" Property="Background" Value="#69D8C2" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Скруглённый тонкий прогресс-бар -->
        <Style x:Key="SlimProgress" TargetType="ProgressBar">
            <Setter Property="Foreground" Value="#69D8C2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="#1A2438" CornerRadius="2" />
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="ALGORITHM LAB" Foreground="#69D8C2" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="Анализ производительности" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,0" />
                <TextBlock Text="Сравнивайте поведение алгоритмов при росте размера входных данных" Foreground="#8995AD" FontSize="14" Margin="0,5,0,0" />
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#142B2B" BorderBrush="#23524D" BorderThickness="1" CornerRadius="20" Padding="12,7">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="#69D8C2" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="ЛОКАЛЬНЫЙ ЭКСПЕРИМЕНТ" Foreground="#9CE8D8" FontSize="10" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
                    </ScrollViewer.Resources>
                    <StackPanel>
                        <TextBlock Text="Параметры запуска" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Настройте алгоритм и размер серии" Foreground="#8995AD" FontSize="12" Margin="0,5,0,21" />

                        <TextBlock Text="АЛГОРИТМ" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="AlgorithmCombo" Style="{StaticResource FieldCombo}" DisplayMemberPath="Name" SelectionChanged="AlgorithmCombo_SelectionChanged" />
                        <TextBlock x:Name="AlgorithmDescription" Text="Выберите алгоритм" Foreground="#8995AD" FontSize="12" TextWrapping="Wrap" Margin="0,9,0,18" MinHeight="34" />

                        <TextBlock Text="МАКСИМАЛЬНЫЙ РАЗМЕР N" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="MaxNBox" Style="{StaticResource FieldBox}" Text="2000" />
                        <TextBlock Text="Число элементов на последней точке графика" Foreground="#65718A" FontSize="11" Margin="0,6,0,15" />

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ШАГ" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="StepBox" Style="{StaticResource FieldBox}" Text="100" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ЗАПУСКОВ" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="RunsBox" Style="{StaticResource FieldBox}" Text="3" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="ВХОДНЫЕ ДАННЫЕ" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="DataTypeCombo" Style="{StaticResource FieldCombo}" Margin="0,0,0,14" SelectedIndex="0">
                            <sys:String>Случайные</sys:String>
                            <sys:String>Отсортированные</sys:String>
                            <sys:String>В обратном порядке</sys:String>
                        </ComboBox>

                        <CheckBox x:Name="CompareCheck" Content="Сравнение алгоритмов (2 и более на одном графике)"
                                  Foreground="#8995AD" FontSize="12" Margin="0,2,0,0"
                                  Checked="CompareCheck_Changed" Unchecked="CompareCheck_Changed" />
                        <Button x:Name="PickCompareButton" Content="Выбрать алгоритмы для сравнения"
                                Click="PickCompareButton_Click" Height="34" Margin="0,9,0,0"
                                Style="{StaticResource DarkButton}" Background="#18243A" FontSize="12"
                                Visibility="Collapsed" />

                        <Button x:Name="RunButton" Content="Построить график" Click="RunButton_Click" Height="46" Style="{StaticResource DarkButton}" Background="#69D8C2" Foreground="#071411" FontSize="14" FontWeight="Bold" />
                        <Button x:Name="CancelButton" Content="Остановить расчёт" Click="CancelButton_Click" Height="38" Margin="0,9,0,0" Style="{StaticResource DarkButton}" Background="#202B42" FontSize="12" IsEnabled="False" />

                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="9" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Button x:Name="SaveDbButton" Grid.Column="0" Content="Сохранить в БД" Click="SaveDbButton_Click" Height="36" Style="{StaticResource DarkButton}" Background="#202B42" FontSize="12" IsEnabled="False" />
                            <Button x:Name="LoadDbButton" Grid.Column="2" Content="Загрузить из БД" Click="LoadDbButton_Click" Height="36" Style="{StaticResource DarkButton}" Background="#202B42" FontSize="12" />
                        </Grid>

                        <CheckBox x:Name="UseCacheCheck" Content="Кэш: подставлять прошлые результаты для тех же вводных"
                                  IsChecked="True" Foreground="#8995AD" FontSize="11" Margin="0,10,0,0" />

                        <ProgressBar x:Name="RunProgress" Height="4" Margin="0,17,0,8" Minimum="0" Maximum="100" Value="0" Style="{StaticResource SlimProgress}" />
                        <TextBlock x:Name="StatusText" Text="Готов к запуску" Foreground="#8995AD" FontSize="11" />

                        <Border Background="#0C1323" BorderBrush="#202B42" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,23,0,0">
                            <StackPanel>
                                <TextBlock Text="Как читать график" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="Бирюзовая линия — результаты замеров. Коралловая — аппроксимация выбранного алгоритма." Foreground="#8995AD" FontSize="11" TextWrapping="Wrap" LineHeight="17" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="#0C1323" BorderBrush="#202B42" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,12,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Очередь экспериментов" FontSize="12" FontWeight="SemiBold" />
                                    <Button x:Name="ClearQueueButton" Grid.Column="1" Content="Очистить" Click="ClearQueueButton_Click"
                                            Height="22" Padding="10,0" Style="{StaticResource DarkButton}" Background="Transparent"
                                            Foreground="#65718A" FontSize="10" IsEnabled="False" />
                                </Grid>
                                <TextBlock Text="Серии запускаются по очереди; готовые можно открыть на графике" Foreground="#65718A" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" />

                                <Button x:Name="AddToQueueButton" Content="＋ Добавить текущие параметры" Click="AddToQueueButton_Click" Height="34" Margin="0,10,0,0" Style="{StaticResource DarkButton}" Background="#18243A" FontSize="12" />

                                <ListBox x:Name="QueueList" MaxHeight="200" Margin="0,10,0,0" Background="Transparent" BorderThickness="0"
                                         Foreground="#E8ECF5" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         SelectionChanged="QueueList_SelectionChanged">
                                    <ListBox.Resources>
                                        <Style BasedOn="{StaticResource SlimScrollBar}" TargetType="ScrollBar" />
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,5" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="9"
                                                                Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}"
                                                                BorderBrush="#202B42" BorderThickness="1">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bg" Property="Background" Value="#141D33" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Bg" Property="Background" Value="#18243A" />
                                                                <Setter TargetName="Bg" Property="BorderBrush" Value="#2C3B58" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.Resources>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="9,7">
                                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="11" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="✕" Click="RemoveQueueItem_Click" Width="22" Height="22" Padding="0"
                                                        VerticalAlignment="Center" Style="{StaticResource DarkButton}" Background="Transparent"
                                                        Foreground="#65718A" FontSize="11" ToolTip="Убрать из очереди" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <CheckBox x:Name="QueueSaveCheckBox" Content="Сохранять результаты очереди в базу данных"
                                          Foreground="#8995AD" FontSize="11" Margin="0,10,0,0" />

                                <Button x:Name="RunQueueButton" Content="Выполнить очередь" Click="RunQueueButton_Click" Height="40" Margin="0,10,0,0"
                                        Style="{StaticResource DarkButton}" Background="#69D8C2" Foreground="#071411" FontSize="13" FontWeight="Bold" IsEnabled="False" />

                                <TextBlock x:Name="QueueStatusText" Text="Очередь пуста" Foreground="#65718A" FontSize="11" Margin="0,9,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Визуализация" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="ChartSubtitle" Text="Выполните серию измерений, чтобы увидеть зависимость времени от N" Foreground="#8995AD" FontSize="12" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel x:Name="LegendPanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <Border Grid.Row="1" Background="#11182A" BorderBrush="#202B42" BorderThickness="1" CornerRadius="18" Padding="16">
                    <Grid>
                        <Canvas x:Name="PlotCanvas" SizeChanged="PlotCanvas_SizeChanged" />
                        <h:HelixViewport3D x:Name="PlotViewport" Visibility="Collapsed"
                                           Background="#11182A" ShowCoordinateSystem="False" ShowViewCube="False"
                                           MouseMove="PlotViewport_MouseMove" MouseLeave="PlotViewport_MouseLeave">
                            <h:DefaultLights />
                            <ModelVisual3D x:Name="SceneRoot" />
                        </h:HelixViewport3D>
                        <Popup x:Name="SurfaceTip" PlacementTarget="{Binding ElementName=PlotViewport}"
                               Placement="MousePoint" StaysOpen="False" AllowsTransparency="True">
                            <Border Background="#18243A" BorderBrush="#2C3B58" BorderThickness="1" CornerRadius="8" Padding="10,7">
                                <TextBlock x:Name="SurfaceTipText" Foreground="#E8ECF5" FontSize="12" />
                            </Border>
                        </Popup>
                        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Border Width="54" Height="54" CornerRadius="16" Background="#18243A" HorizontalAlignment="Center" Margin="0,0,0,14">
                                <TextBlock Text="↗" FontSize="27" Foreground="#69D8C2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="График появится здесь" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Выберите параметры и запустите эксперимент" Foreground="#8995AD" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                        <StackPanel><TextBlock Text="СРЕДНЕЕ ВРЕМЯ" Foreground="#8995AD" FontSize="10" FontWeight="SemiBold" /><TextBlock x:Name="MeanMetric" Text="—" FontSize="21" FontWeight="SemiBold" Margin="0,7,0,0" /><TextBlock Text="по всем точкам" Foreground="#65718A" FontSize="10" Margin="0,3,0,0" /></StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                        <StackPanel><TextBlock Text="АППРОКСИМАЦИЯ" Foreground="#8995AD" FontSize="10" FontWeight="SemiBold" /><TextBlock x:Name="ComplexityMetric" Text="—" FontSize="21" FontWeight="SemiBold" Margin="0,7,0,0" Foreground="#FF9E8B" /><TextBlock x:Name="ComplexityNote" Text="ожидаемая сложность" Foreground="#65718A" FontSize="10" Margin="0,3,0,0" /></StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource MetricCard}">
                        <StackPanel><TextBlock Text="ТОЧЕК НА ГРАФИКЕ" Foreground="#8995AD" FontSize="10" FontWeight="SemiBold" /><TextBlock x:Name="PointsMetric" Text="—" FontSize="21" FontWeight="SemiBold" Margin="0,7,0,0" Foreground="#69D8C2" /><TextBlock x:Name="PointsNote" Text="размеров входных данных" Foreground="#65718A" FontSize="10" Margin="0,3,0,0" /></StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
